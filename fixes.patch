+/* ===== TAP FEEDBACK / PAGE TRANSITIONS / SCROLL STABILITY ===== */
+/* 1. No square tap box: kill the WebView's default tap highlight everywhere, keep ripples clipped to the button shape. */
+*{-webkit-tap-highlight-color:transparent;}
+button,.btn,.backBtn,.dashTabs button,.kpiSwitch button,.heroCameraBtn,.docLink,[role=button]{-webkit-touch-callout:none;-webkit-user-select:none;user-select:none;touch-action:manipulation;}
+button:focus:not(:focus-visible),a:focus:not(:focus-visible){outline:none;}
+.btn,.backBtn{overflow:hidden;}
+.heroCameraBtn .uiRipple{display:none;}
+/* Touch screens keep :hover "stuck" after a tap, which made tapped buttons/cards stay lifted. */
+@media (hover:none){
+  .btn:hover:not(:active),.backBtn:hover:not(:active){transform:none !important;}
+  .btn:hover::before{left:-90px !important;}
+  .card:hover{transform:translateZ(0) !important;}
+  .timelineItem:hover{padding-left:2px;padding-right:2px;background:none;}
+  #screen-dashboard>.btn:hover::after{transform:none;}
+  .backBtn:hover{transform:none;}
+}
+/* 2. ONE entry animation for every screen, ONE exit animation for every screen. */
+@keyframes fosEnter{from{opacity:0;transform:translateY(12px);}to{opacity:1;transform:none;}}
+@keyframes fosExit{from{opacity:1;transform:none;}to{opacity:0;transform:translateY(-6px);}}
+html body .screen.active,
+html body .screen.active.dir-back,
+html body #screen-docviewer.screen.active{animation:fosEnter .3s cubic-bezier(.16,1,.3,1) backwards;}
+.screen.leaving{display:flex;pointer-events:none;animation:fosExit .18s ease-in forwards;}
+.screen.leaving:not(#screen-docviewer){position:fixed;top:0;bottom:0;left:2px;right:2px;margin:0 auto;max-width:496px;min-height:0;overflow:hidden;z-index:5;}
+/* 3. Smooth-scroll made every automatic scroll reset visibly "glide"; page changes must land instantly. */
+html{scroll-behavior:auto !important;}
